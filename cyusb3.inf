; ============================================================================
; cyusb3_arm64.inx - Cypress CyUSB3 driver INF template with ARM64 support
; and the Mantra MFS110 hardware ID added.
;
; Derived from Cypress's src/cyusb3.inx (DriverVer 04/01/2016, 1.2.3.16).
;
; CHANGES VS THE STOCK .inx
;
;  1. [Manufacturer] gains NTarm64.
;  2. [Device.NTarm64] added - contains ONLY the Mantra MFS110 IDs. Listing
;     Cypress's own VID_04B4 products here is pointless for us and would let
;     this driver grab unrelated Cypress demo hardware.
;  3. [CYUSB3.NTarm64], [CYUSB3.NTarm64.HW], [CYUSB3.NTarm64.Services] and
;     [CYUSB3.NTarm64.Wdf] added, mirroring the x64 set.
;  4. The WDF co-installer is NOT carried into ARM64. Microsoft dropped ARM64
;     co-installer support after Windows 10, and the co-installer DLL that
;     ships with this suite is x64-only. KMDF is in-box on Win10/11, so the
;     CoInstallers32 directive is unnecessary on ARM64. The
;     [CYUSB3_wdfsect] binding is retained so the driver still declares its
;     framework version.
;
; WHY THE DRIVER KEEPS THE NAME "CYUSB3"
;
; MFS110_Core.dll finds its device with SetupDiGetClassDevs on a GUID that is
; passed INTO the CCyUSBDevice constructor, not the Cypress default. Static
; analysis of MFS110_Core.dll finds Mantra's GUID present twice and Cypress's
; stock {AE18AA60-...} exactly once; the latter is just CyAPI's compiled-in
; default. So the driver MUST register under Mantra's GUID or the RD Service
; will never locate the scanner. It also talks to the driver through the
; CyUSB3 IOCTL set (cyioctl.h). Renaming the service to M0082 would change the
; device interface path, so the service stays CYUSB3 and only the hardware ID
; list and the interface GUID are changed.
;
; PLACEHOLDERS filled in by the WDK build (stampinf), same as the stock file:
;   $KMDFCOINSTALLERVERSION$   - co-installer version
;   $KMDFVERSION$              - KMDF library version
; ============================================================================

[Version]
Signature="$WINDOWS NT$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
provider=%CYUSB3_Provider%
CatalogFile=CYUSB3.cat
DriverVer = 04/02/2016,1.2.3.16

[SourceDisksNames]
1=%CYUSB3_Install%,,,

[SourceDisksFiles]
CYUSB3.sys = 1
;


[DestinationDirs]
CYUSB3.Files.Ext = 10,System32\Drivers
CoInstaller_CopyFiles = 11

[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%CYUSB3_Provider%=Device,NT,NTx86,NTamd64,NTarm64

;for all platforms
